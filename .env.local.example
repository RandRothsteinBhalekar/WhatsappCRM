# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Local PostgreSQL (docker compose service `db` defaults shown)
DATABASE_URL=postgres://wacrm:wacrm@localhost:5432/wacrm
POSTGRES_USER=wacrm
POSTGRES_PASSWORD=wacrm
POSTGRES_DB=wacrm
POSTGRES_PORT=5432

# better-auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public origin used in auth emails / cookies
BETTER_AUTH_URL=http://localhost:3000

# Invite-only auth: only this email may create the first (owner) account
# when the database has no accounts yet. After that, signup requires an
# email-bound invite from Settings → Members.
OWNER_EMAIL=you@example.com

# Local media storage root (avatars, chat-media, flow-media)
MEDIA_ROOT=./data/media

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED
# ============================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL
# ============================================================

# ALLOWED_INVITE_HOSTS=crm.example.com
# AUTOMATION_CRON_SECRET=generate-a-long-random-string
# META_APP_ID=your-meta-app-id
# WHATSAPP_TEMPLATES_DRY_RUN=true
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
# AI_PROVIDER_ALLOWED_PRIVATE_HOSTS=127.0.0.1,ollama.internal
# HOST_PORT=3000
